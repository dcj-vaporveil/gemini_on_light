<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thelightphone.gemini">

    <!-- Network permissions for Gemini REST API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Audio recording permission for voice search -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="Gemini Search"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- LightActivity handled by Light SDK runtime -->
        <activity
            android:name="com.thelightphone.sdk.LightActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
